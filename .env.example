MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/spamguard?retryWrites=true&w=majority
PORT=5000
API_KEY=change_this_to_a_long_random_string

# Auth
JWT_SECRET=change_this_to_a_long_random_string_too
JWT_EXPIRES_IN=7d

# Gmail SMTP for OTP emails (use a Gmail App Password, not your real password)
# Generate at: myaccount.google.com/apppasswords (needs 2FA enabled on the Gmail account)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
